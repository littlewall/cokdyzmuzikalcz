---
import Default from '../layouts/Default.astro';
import Header from '../components/Header.client';
import Menu from '../components/Menu.client';

interface Props {
	title?: string;
	description?: string;
	canonicalUrl?: string;
}

const { title = 'Co když..? - nový původní český muzikál', description, canonicalUrl } = Astro.props;
---

<Default title={title} description={description} canonicalUrl={canonicalUrl}>
	<main class="main">
		<Header client:load />

		<Menu client:load />

		<div class="content" id="o-muzikalu">
			<div class="copy">
				<strong>
					V záři blížícího se meteoroidu dostává šest mladých lidí šanci napravit chyby minulosti dřív,
				 než padající hvězda splní jejich poslední přání. Najdou ale odvahu říct, po čem doopravdy touží?
				</strong>
				<p>
					Původní český muzikál s intimním příběhem o tom, že někdy musíme ztratit všechno, abychom našli to nejdůležitější.
				</p>
			</div>
			<div class="video">
				<iframe
					src="https://player.cloudinary.com/embed/?public_id=mhxyw0cf98timxi0rsfh&cloud_name=da9ua4xl4&profile=WIweb"
					width="640"
					height="360"
					style="height: 100%; width: 100%; aspect-ratio: 640 / 360; position: absolute; top: 0;"
					allowFullScreen={false}
				></iframe>
			</div>
		</div>

		<div class="content" id="tvurci-obsazeni">
			<div class="creativesCard fullWidth">
				<div class="name">
					<div class="imageWrapper">
						<div class="image" style="background-image: url('/images/creatives/milanzitka.png');"></div>
					</div>
				</div>
				<div class="description">
					<h3>Milan Zítka</h3>
					<strong>hudba, texty, scénář</strong>
					<p>
						Hudebník, skladatel a textař, jehož cesta k muzikálu vedla přes jeviště i hudební studia.
						Jako muzikálový herec účinkoval v inscenacích RENT, Ples upírů, Fantom opery či Les Misérables (Bídníci).
						V autorské tvorbě spojuje vášeň pro hudbu s vyprávěním příběhů. Jeho muzikálovou prvotinou
						byl muzikál Mistr jazzu, který se uváděl v Karlovarském městském divadle.
					</p>
				</div>
			</div>
		</div>

		<footer class="footer">
			<p class="copy">&copy; 2025 Milan Zítka</p>
		</footer>
	</main>

	<style is:global>
		.main {
			display: flex;
			flex-direction: column;
			justify-content: space-between;
			align-items: center;
			min-height: 100vh;
		}

		.content {
			display: flex;
			width: 100%;
			margin: 0 auto;
			padding: 3rem 1rem;
			max-width: 500px;
			flex-direction: column;
			align-items: center;
			position: relative;
			gap: 4rem;
		}

		@media (min-width: 900px) {
			.content {
				flex-direction: row;
				max-width: 1000px;
			}
		}

		.content .copy {
			margin-top: 1rem;
			font-size: 1.2rem;
			line-height: 1.25;
			font-weight: 300;
			color: #333;
		}

		@media (min-width: 900px) {
			.content .copy {
				font-size: 1.4rem;
				max-width: 60%;
			}
		}

		.content .copy strong {
			font-weight: 700;
			font-size: 1.5em;
			margin-bottom: 2rem;
			display: block;
		}

		.content .copy p {
			margin-bottom: 1rem;
		}

		.content .video {
			width: 100%;
			height: 100%;
			margin-top: 3rem;
			padding: 100% 0 0 0;
			position: relative;
		}

		@media (min-width: 900px) {
			.content .video {
				padding: 50% 0 0 0;
			}
		}

		.content .video iframe {
			border: none;
		}

		.creativesCard {
			display: flex;
			gap: 2rem;
			flex-direction: column;
			max-width: 50%;
		}

		@media (min-width: 900px) {
			.creativesCard {
				flex-direction: row;
			}
		}

		.creativesCard.fullWidth {
			max-width: 100%;
		}

		.creativesCard .name {
			display: flex;
			flex-direction: column;
			justify-content: center;
			align-items: center;
		}

		.creativesCard .name .imageWrapper {
			width: 50vw;
			max-width: 150px;
			height: 50vw;
			max-height: 150px;
			display: block;
			position: relative;
			clip-path: circle(50% at 50% 50%);
		}

		.creativesCard .name .imageWrapper .image {
			background-position: 50%;
			background-repeat: no-repeat;
			background-size: cover;
			bottom: 0;
			left: 0;
			position: absolute;
			right: 0;
			top: 0;
		}

		.creativesCard .description {
			display: flex;
			flex-direction: column;
			justify-content: center;
			align-items: center;
			width: 100%;
		}

		@media (min-width: 900px) {
			.creativesCard .description {
				align-items: flex-start;
				width: 70%;
			}
		}

		.creativesCard .description strong {
			font-weight: 300;
			font-size: .75em;
			margin-bottom: .75rem;
			display: block;
		}

		.creativesCard .description p {
			margin-bottom: 1rem;
			font-weight: 300;
			line-height: 1.25;
			width: 100%;
			max-width: 400px;
		}

		@media (min-width: 900px) {
			.creativesCard .description p {
				max-width: 100%;
			}
		}

		.footer {
			display: flex;
			flex-direction: column;
			justify-content: center;
			align-items: center;
			width: 100%;
			padding: 2rem 1rem;
			background: #050b28;
			color: white;
		}

		.footer .copy {
			font-size: .75rem;
			font-weight: 300;
			text-align: center;
		}
	</style>
</Default>